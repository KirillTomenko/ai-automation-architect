# OpenAI-совместимый базовый URL ProxyAPI
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1
LLM_API_KEY=

# Модель по умолчанию (меняется без правок кода)
LLM_MODEL=gpt-4o-mini
# Отдельная модель для Stage 1 (по умолчанию — LLM_MODEL). Раскомментируй,
# чтобы взять более сильную модель точнее в gap-детекции, но дороже:
# LLM_MODEL_STAGE1=gpt-4.1

# Параметры вызова LLM
LLM_TEMPERATURE=0.3
# Отдельная (пониженная) temperature для Stage 1 — стабильность извлечения
LLM_TEMPERATURE_STAGE1=0.1
LLM_TIMEOUT_S=45
LLM_MAX_TOKENS=3000